# Forward waitlist signups to any HTTPS endpoint that accepts a JSON POST.
# Leave blank in local dev — submissions are written to data/waitlist.dev.json.
WAITLIST_WEBHOOK_URL=

# Alternatively, insert into a Supabase `waitlist` table. See the README for SQL.
# Use the service role key on the server only. Never prefix it with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
